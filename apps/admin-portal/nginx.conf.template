server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  # Public HTTPS terminates at App Service, not the container's :8080.
  absolute_redirect off;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://login.microsoftonline.com ${GATEWAY_ORIGIN} ${CONTROL_ORIGIN}; frame-src https://login.microsoftonline.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;

  # Front Door preserves the /admin prefix; App Service probes may hit either path.
  location = /healthz { access_log off; add_header Content-Type text/plain; return 200 "ok"; }
  location = /admin/healthz { access_log off; add_header Content-Type text/plain; return 200 "ok"; }

  # Fixed private API upstream; retain caller Authorization for API-side RBAC.
  location ^~ /api/ {
    proxy_pass https://poc-ids-token-ex-api.azurewebsites.net;
    proxy_set_header Host poc-ids-token-ex-api.azurewebsites.net;
    proxy_ssl_server_name on;
    proxy_ssl_name poc-ids-token-ex-api.azurewebsites.net;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 5;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
    proxy_buffering off;
    add_header Cache-Control "no-store" always;
  }

  location /admin/assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  location = /admin/redirect.html {
    add_header Cache-Control "no-store";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    try_files $uri =404;
  }

  location = / { return 302 /admin/; }

  location /admin/ {
    add_header Cache-Control "no-store";
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://login.microsoftonline.com ${GATEWAY_ORIGIN} ${CONTROL_ORIGIN}; frame-src https://login.microsoftonline.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    try_files $uri /admin/index.html;
  }
}